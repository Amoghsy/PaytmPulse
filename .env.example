# Database Configuration (Supabase / PostgreSQL)
# Example Supabase URI: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=paytm_pulse
POSTGRES_USER=paytm_pulse
POSTGRES_PASSWORD=paytm_pulse_secret_key

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# FastAPI Backend Configuration
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# n8n Configuration
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Phase 3 Event Pipeline Configuration
EVENT_DEMAND_SPIKE_THRESHOLD=2.0
EVENT_SALES_DECLINE_THRESHOLD=0.30
EVENT_COOLDOWN_MINUTES=15
REDIS_RECENT_TRANSACTION_LIMIT=50

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Phase 5 Google ADK / Gemini Configuration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Phase 7 WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=paytm_pulse_webhook_verify_token_2026
WHATSAPP_API_VERSION=v20.0
WHATSAPP_MOCK_MODE=true

# Phase 7 Sarvam AI Voice Configuration
SARVAM_API_KEY=
SARVAM_MOCK_MODE=true

# Communication & Notification Configuration
ALERT_COOLDOWN_MINUTES=30

# Phase 8 Action Execution & Paytm Configuration
EXECUTION_MODE=mock
MAX_EXECUTION_RETRIES=3
MOCK_EXECUTION_DELAY_MS=0
MOCK_FAILURE_RATE=0.0
PAYTM_ENABLED=false
PAYTM_BASE_URL=
PAYTM_CLIENT_ID=
PAYTM_CLIENT_SECRET=


